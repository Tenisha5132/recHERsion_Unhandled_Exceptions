# Optional OpenAI-compatible LLM or local SLM. Leave blank for rules-only fallback.
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Hosted example: https://api.openai.com/v1
# Local Ollama example: http://localhost:11434/v1
LLM_BASE_URL=
LLM_TIMEOUT=10

# Retrieval relevance floor. Lower keeps more chunks; higher is stricter.
MIN_RETRIEVAL_SCORE=0.30

# Set true when the app is served over HTTPS.
COOKIE_SECURE=false
